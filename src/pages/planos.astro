---
import PlansPage from '../components/pages/PlansPage.astro';
import { site } from '../config/site';
import { pageLocale } from '../i18n';
import { sectionPath } from '../i18n/routes';
// Preços ainda em definição: quem chega por um link antigo vai para a cotação na Home.
const { locale } = pageLocale(Astro);
if (!site.pricing.showPrices) return Astro.redirect(sectionPath(locale, 'home', 'quote'), 301);
---

<PlansPage />

---
import Layout from '../layouts/Layout.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Icon from '../components/Icon.astro';
import FeatureValue from '../components/FeatureValue.astro';
import { site, featureGroups, faq } from '../config/site';
import { softwareApplicationSchema } from '../lib/schema';
const schema = [
  softwareApplicationSchema('planos'),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---

<Layout
  title="Planos e preços | ARP Vision"
  description="Planos ARP Vision: Individual com pagamento único, Professional e Business mensais e Enterprise sob consulta. Compare créditos, tours no ar e teste grátis."
  ogImage={site.media.ogPlans}
  schema={schema}
>
  <section class="section plans-page">
    <div class="container">
      <div class="section-heading center">
        <a class="breadcrumb" href="/">
          Início / Planos
        </a>
        <span class="eyebrow">O PRÓXIMO PASSO DO SEU NEGÓCIO</span>
        <h1>
          Planos para todo
          <br />
          tamanho de negócio
        </h1>
        <p>
          1 crédito = 1 ambiente fotografado com o celular.
          <br />
          Um espaço costuma ter de 6 a 10 ambientes.
        </p>
      </div>
      <Pricing full />
    </div>
  </section>
  <section class="section feature-comparison" id="comparar">
    <div class="container">
      <div class="section-heading center">
        <span class="eyebrow">CADA DETALHE, LADO A LADO</span>
        <h2>Compare todos os recursos.</h2>
        <p>Compare o que cada plano inclui para capturar e publicar seus espaços.</p>
      </div>
      <div
        class="feature-table-wrap"
        tabindex="0"
        role="region"
        aria-label="Tabela comparativa dos planos, com rolagem horizontal"
      >
        <table class="feature-table">
          <thead>
            <tr>
              <th scope="col">Recursos</th>
              {site.pricing.plans.map((plan) => (
                <th scope="col" class:list={{ 'recommended-cell': plan.recommended }}>
                  {plan.name}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {featureGroups.map((group) => (
              <>
                <tr class="feature-group">
                  <th colspan={site.pricing.plans.length + 1} scope="colgroup">
                    {group.title}
                  </th>
                </tr>
                {group.rows.map((row) => (
                  <tr>
                    <th scope="row">{row.name}</th>
                    {row.values.map((value, index) => (
                      <td
                        class:list={{ 'recommended-cell': site.pricing.plans[index].recommended }}
                      >
                        <FeatureValue value={value} />
                      </td>
                    ))}
                  </tr>
                ))}
              </>
            ))}
          </tbody>
        </table>
      </div>
      <!-- No celular, a tabela larga vira uma lista por plano (a tabela fica oculta via CSS). -->
      <div class="feature-plans">
        {site.pricing.plans.map((plan, index) => (
          <details class="feature-plan" open={plan.recommended} data-feature-plan={plan.id}>
            <summary>
              <span>
                {plan.name}
                {plan.recommended && <span class="feature-plan-badge">Recomendado</span>}
              </span>
              <Icon name="plus" size={20} />
            </summary>
            {featureGroups.map((group) => (
              <div class="feature-plan-group">
                <h3>{group.title}</h3>
                <dl>
                  {group.rows.map((row) => (
                    <div>
                      <dt>{row.name}</dt>
                      <dd>
                        <FeatureValue value={row.values[index]} />
                      </dd>
                    </div>
                  ))}
                </dl>
              </div>
            ))}
          </details>
        ))}
      </div>
    </div>
  </section>
  <Faq />
  <FinalCta />
</Layout>

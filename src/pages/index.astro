---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Tour from '../components/Tour.astro';
import Calculator from '../components/Calculator.astro';
import Credits from '../components/Credits.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import MarketNote from '../components/MarketNote.astro';
import FanCards from '../components/FanCards.astro';
import FeatureStack from '../components/FeatureStack.astro';
import { site, available, faq, alternatives, alternativeLabels } from '../config/site';
import { appLink } from '../lib/business';
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
const arpAlternative = alternatives[3];
const otherAlternatives = alternatives.slice(0, 3);
const uses = [
  {
    icon: 'home',
    number: '01',
    title: 'Antes da visita.',
    text: 'Mande o tour antes de a pessoa ir até você. Quem chega já conhece o espaço e vem decidido.',
    tag: 'A experiência começa antes da visita',
  },
  {
    icon: 'message',
    number: '02',
    title: 'No WhatsApp.',
    text: 'O cliente abre o link sem criar conta e vê o espaço inteiro em um minuto.',
    tag: 'Uma visita começa com um link',
  },
  {
    icon: 'globe',
    number: '03',
    title: 'No seu site.',
    text: 'Cole o código na página e mostre por dentro o que uma foto sozinha não mostra.',
    tag: 'Seu espaço, em todos os ângulos',
  },
];
const features = [
  ...uses,
  {
    icon: 'users',
    number: '04',
    title: 'Capture com a equipe.',
    text: 'Cada pessoa entra com o próprio acesso e captura com o celular. O saldo de créditos é compartilhado pela empresa.',
    tag: 'Mais autonomia, um só saldo',
  },
  {
    icon: 'audit',
    number: '05',
    title: 'Veja quem fez o quê.',
    text: 'A auditoria registra quem criou e editou cada tour, com data e hora. Mais visibilidade para quem faz a gestão.',
    tag: 'Gestão com visibilidade',
  },
];
const roomCards = site.media.fanRooms.map((room, index) => ({
  ...room,
  number: String(index + 1).padStart(2, '0'),
}));
const teams = [
  {
    icon: 'credits',
    title: 'Créditos da empresa.',
    text: 'Um saldo só, da empresa. Você contrata uma vez e toda a equipe usa.',
  },
  {
    icon: 'users',
    title: 'Equipe.',
    text: 'Cadastre quem vai capturar, e cada pessoa entra com o próprio acesso.',
  },
  {
    icon: 'audit',
    title: 'Auditoria.',
    text: 'Veja quem criou e quem editou cada tour, com data e hora.',
  },
  {
    icon: 'target',
    title: 'Mesmo padrão para todos.',
    text: 'A captura guiada faz quem nunca fotografou e quem já é experiente entregarem o mesmo resultado.',
  },
];
---

<Layout title="Tour virtual 360° com o celular | ARP Vision" schema={[faqSchema]}>
  <section class="hero opening" aria-labelledby="opening-title">
    <div class="container">
      <div class="opening-copy center">
        <span class="eyebrow">
          <span class="eyebrow-line"></span> TOUR VIRTUAL 360° PARA O SEU NEGÓCIO
        </span>
        <h1 id="opening-title">
          Transforme o seu espaço em uma experiência.
          <br />
          <span>Só com o celular.</span>
        </h1>
        <p class="opening-description">
          Faça o tour virtual 360° do seu espaço só com o celular. As emendas e a luz saem
          corrigidas, e o cliente abre o tour pelo WhatsApp, sem criar conta.
        </p>
      </div>
      <FanCards items={roomCards} />
    </div>
  </section>
  <section class="hero presentation" aria-labelledby="presentation-title">
    <div class="container presentation-heading">
      <div class="hero-copy">
        <span class="eyebrow">MAIS DO QUE UM LINK BONITO</span>
        <h2 id="presentation-title">Onde o tour trabalha por você.</h2>
        <p>Da primeira conversa à próxima visita.</p>
        <div class="hero-actions">
          <a class="button button-primary" href={appLink('hero')} data-cta="hero">
            Criar conta grátis <Icon name="arrow" size={19} />
          </a>
          {available.tour ? (
            <a class="button button-secondary" href="#tour-real">
              <Icon name="play" size={18} /> Ver um tour de verdade
            </a>
          ) : (
            <a class="button button-secondary" href="#como-funciona">
              <Icon name="play" size={18} /> Ver como funciona
            </a>
          )}
        </div>
      </div>
    </div>
    <FeatureStack src={site.media.heroEmbed} items={features} />
  </section>
  <section class="facts-strip" aria-label="Destaque">
    <div class="container fact">
      <span class="fact-icon">
        <Icon name="phone" size={23} />
      </span>
      <div>
        <strong>Só o celular.</strong>
        <p>Sem câmera 360°, sem tripé.</p>
      </div>
    </div>
  </section>
  <Tour />
  <section class="section how-section" id="como-funciona">
    <div class="container how-grid">
      <div>
        <span class="eyebrow">TRÊS PASSOS. NENHUM EQUIPAMENTO EXTRA.</span>
        <h2>Do celular ao tour publicado, no mesmo dia.</h2>
        <div class="steps">
          <article>
            <span class="step-number">01</span>
            <div>
              <h3>Capture.</h3>
              <p>
                Abra a ARP Vision no navegador do celular e gire devagar seguindo as bolinhas. Cada
                ambiente leva 8 fotos, numa volta só.
              </p>
            </div>
          </article>
          <article>
            <span class="step-number">02</span>
            <div>
              <h3>A ARP Vision monta.</h3>
              <p>As fotos viram um 360°, e você continua capturando todo o espaço.</p>
            </div>
          </article>
          <article>
            <span class="step-number">03</span>
            <div>
              <h3>Publique.</h3>
              <p>
                Marque as passagens entre os ambientes e publique. Mande o link no WhatsApp ou cole
                o código no seu site.
              </p>
            </div>
          </article>
        </div>
      </div>
      <!-- Vídeo sem moldura: toca sozinho quando aparece na tela; o botão pausa. -->
      <div class="tutorial-video">
        <video
          id="tutorial-video"
          src={site.media.tutorial}
          poster={site.media.tutorialPoster}
          width="720"
          height="1280"
          muted
          loop
          playsinline
          preload="none"
          data-autoplay
          aria-label="Tutorial da captura 360 graus da ARP Vision"
        ></video>
        <button
          class="video-toggle"
          data-video-toggle="tutorial-video"
          aria-label="Reproduzir vídeo"
        >
          <span class="video-toggle-play">
            <Icon name="play" size={18} />
          </span>
          <span class="video-toggle-pause">
            <Icon name="pause" size={18} />
          </span>
        </button>
      </div>
    </div>
  </section>
  <section class="section alternatives-section">
    <div class="container">
      <div class="section-heading center">
        <span class="eyebrow">COLOQUE NA PONTA DO LÁPIS</span>
        <h2>
          Quanto custa mostrar
          <br />
          um espaço por dentro?
        </h2>
        <p>Compare o equipamento, o tempo e o jeito de trabalhar.</p>
      </div>
      <div class="alternatives-desktop">
        <table class="alternatives-table">
          <thead>
            <tr>
              <th scope="col">O que faz diferença</th>
              {alternatives.map((alternative, i) => (
                <th scope="col" class:list={{ 'arp-column': i === 3 }}>
                  <Icon name={alternative.icon} size={22} />
                  <span>{alternative.name}</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {alternativeLabels.map((label, index) => (
              <tr>
                <th scope="row">{label}</th>
                {alternatives.map((alternative, i) => (
                  <td class:list={{ 'arp-column': i === 3 }}>{alternative.values[index]}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <!-- No celular: ARP Vision primeiro e aberta; as alternativas ficam recolhidas. -->
      <div class="alternatives-mobile">
        {[arpAlternative, ...otherAlternatives].map((alternative) => (
          <details
            class:list={['alternative-card', { 'arp-alternative': alternative === arpAlternative }]}
            open={alternative === arpAlternative}
          >
            <summary>
              <h3>
                <Icon name={alternative.icon} />
                {alternative.name}
              </h3>
              <Icon name="plus" size={20} />
            </summary>
            <dl>
              {alternativeLabels.map((label, index) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{alternative.values[index]}</dd>
                </div>
              ))}
            </dl>
          </details>
        ))}
      </div>
      <MarketNote id="referencia-camera" />
      <p class="footnote">
        ² Custo por espaço calculado na assinatura mensal com uso integral dos créditos e{' '}
        {site.pricing.averageRooms} ambientes por espaço.
      </p>
      <div class="comparison-quote">
        <Icon name="phone" size={31} />
        <p>
          Uma câmera 360° para a equipe inteira vira fila.
          <br />
          <strong>Com a ARP Vision, cada pessoa já tem a sua no bolso.</strong>
        </p>
      </div>
    </div>
  </section>
  <section class="section team-section">
    <div class="container">
      <div class="team-intro">
        <div>
          <span class="eyebrow">UMA FERRAMENTA. A EQUIPE TODA.</span>
          <h2>
            Feito para a empresa inteira,
            <br />
            não só para uma pessoa.
          </h2>
        </div>
        <p>
          Mais autonomia para quem captura.
          <br />
          Mais visibilidade para quem faz a gestão.
        </p>
      </div>
      <div class="team-features">
        {teams.map((team) => (
          <article>
            <span class="icon-tile">
              <Icon name={team.icon} size={22} />
            </span>
            <div>
              <h3>{team.title}</h3>
              <p>{team.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <Credits />
  <Calculator />
  <section class="section plans-preview" id="planos">
    <div class="container">
      <div class="section-heading center">
        <span class="eyebrow">COMECE PEQUENO. MOSTRE POR INTEIRO.</span>
        <h2>Um plano para o seu próximo passo.</h2>
        <p>1 crédito = 1 ambiente fotografado com o celular. O saldo é da sua empresa.</p>
      </div>
      <Pricing />
    </div>
  </section>
  <Faq />
  <FinalCta />
</Layout>

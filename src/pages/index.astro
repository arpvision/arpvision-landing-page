---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Tour from '../components/Tour.astro';
import Credits from '../components/Credits.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import FanCards from '../components/FanCards.astro';
import TourShowcase from '../components/TourShowcase.astro';
import Sharing from '../components/Sharing.astro';
import TeamBenefits from '../components/TeamBenefits.astro';
import { site, faq } from '../config/site';
import { softwareApplicationSchema } from '../lib/schema';
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
const openingDescription =
  'Faça o tour virtual 360° do seu espaço só com o celular. E o cliente abre o tour sem criar conta.';
// Texto do resultado de busca: entre 140 e 160 caracteres para não ser cortado pelo Google.
const metaDescription =
  'Crie o tour virtual 360° do seu espaço só com o celular. Emendas e luz corrigidas, link pronto para o WhatsApp e o cliente abre sem criar conta. Teste grátis.';
const roomCards = site.media.fanRooms.map((room, index) => ({
  ...room,
  number: String(index + 1).padStart(2, '0'),
}));
---

<Layout
  title="Tour virtual 360° com o celular | ARP Vision"
  description={metaDescription}
  schema={[softwareApplicationSchema('home'), faqSchema]}
>
  <section class="hero opening" aria-labelledby="opening-title">
    <div class="container">
      <div class="opening-copy center">
        <span class="eyebrow">
          <span class="eyebrow-line"></span> TOUR VIRTUAL 360° PARA O SEU NEGÓCIO
        </span>
        <h1 id="opening-title">
          Transforme o seu espaço em uma experiência.
          <br />
          <span>Só com o celular.</span>
        </h1>
        <p class="opening-description">{openingDescription}</p>
      </div>
      <FanCards items={roomCards} />
    </div>
  </section>
  <section
    class="section how-section"
    id="como-funciona"
    data-atmosphere="how"
    aria-labelledby="capture-heading"
  >
    <div class="container how-grid">
      <div>
        <h2 class="capture-heading" id="capture-heading">
          O app tira as fotos para você
        </h2>
        <p class="capture-subtitle">Abra a câmera e siga as instruções</p>
        <div class="steps">
          <article>
            <span class="step-number">01</span>
            <h3>Capture com seu próprio celular.</h3>
          </article>
          <article>
            <span class="step-number">02</span>
            <h3>A ARP Vision monta.</h3>
          </article>
          <article>
            <span class="step-number">03</span>
            <h3>Pronto, agora é só compartilhar.</h3>
          </article>
        </div>
      </div>
      <!-- Vídeo sem moldura: toca sozinho quando aparece na tela; o botão pausa. -->
      <div class="tutorial-video">
        <video
          id="tutorial-video"
          src={site.media.tutorial}
          poster={site.media.tutorialPoster}
          width="720"
          height="1280"
          muted
          loop
          playsinline
          preload="none"
          data-autoplay
          aria-label="Tutorial da captura 360 graus da ARP Vision"
        ></video>
        <button
          class="video-toggle"
          data-video-toggle="tutorial-video"
          aria-label="Reproduzir vídeo"
        >
          <span class="video-toggle-play">
            <Icon name="play" size={18} />
          </span>
          <span class="video-toggle-pause">
            <Icon name="pause" size={18} />
          </span>
        </button>
      </div>
    </div>
  </section>
  <Credits />
  <Sharing />
  <section class="hero presentation" aria-labelledby="presentation-title" data-atmosphere="demo">
    <div class="container presentation-heading">
      <div class="hero-copy">
        <h2 id="presentation-title">Onde o tour trabalha por você.</h2>
      </div>
    </div>
    <TourShowcase src={site.media.heroEmbed} />
  </section>
  <Tour />
  <TeamBenefits />
  <section class="section plans-preview" id="planos">
    <div class="container">
      <div class="section-heading center">
        <span class="eyebrow">COMECE PEQUENO. MOSTRE POR INTEIRO.</span>
        <h2>Um plano para o seu próximo passo.</h2>
        <p>1 crédito = 1 ambiente fotografado com o celular. O saldo é da sua empresa.</p>
      </div>
      <Pricing />
    </div>
  </section>
  <Faq />
  <FinalCta />
</Layout>

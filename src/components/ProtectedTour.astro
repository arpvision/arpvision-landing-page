---
import GlassSurface from './GlassSurface.astro';
import Icon from './Icon.astro';
import { pageLocale } from '../i18n';
interface Props {
  src: string;
}
const { src } = Astro.props;
const { t } = pageLocale(Astro);
---

<div class="protected-tour" data-protected-tour data-tour-active="false">
  <iframe
    id="presentation-tour"
    class="hero-embed"
    src={src}
    title={t.showcase.frameTitle}
    allow="fullscreen"
    allowfullscreen
    referrerpolicy="strict-origin-when-cross-origin"
    tabindex="-1"
    inert
  ></iframe>
  <div class="tour-shield" data-tour-shield>
    <button
      class="glass-surface tour-unlock"
      data-glass-clear
      data-tour-activate
      aria-controls="presentation-tour"
      aria-expanded="false"
    >
      <span class="tour-entry-copy">
        <span class="tour-entry-icon">
          <Icon name="expand" size={28} />
        </span>
        <strong>{t.showcase.title}</strong>
        <span>{t.showcase.hint}</span>
      </span>
    </button>
    <noscript>
      <a class="glass-surface tour-fallback" href={src} target="_blank" rel="noopener noreferrer">
        {t.showcase.newTab} <Icon name="arrow" size={18} />
      </a>
    </noscript>
  </div>
  <GlassSurface class="tour-exit-panel">
    <button data-tour-lock aria-controls="presentation-tour">
      <Icon name="shield" size={18} /> {t.showcase.exit}
    </button>
  </GlassSurface>
</div>
<script>
  import '../scripts/protected-tour';
</script>

---
import Icon from './Icon.astro';
import GlassSurface from './GlassSurface.astro';
import { pageLocale } from '../i18n';
const { t } = pageLocale(Astro);
// O terceiro benefício será acrescentado quando seu texto estiver definido.
const benefits = [
  { icon: 'users', ...t.team.benefits.autonomy },
  { icon: 'target', ...t.team.benefits.standard },
];
---

<section class="section team-section" data-atmosphere="team" aria-labelledby="benefits-title">
  <div class="container">
    <div class="section-heading center benefits-heading">
      <span class="eyebrow">{t.team.eyebrow}</span>
      <h2 id="benefits-title">
        {t.team.title1}
        <br /> {t.team.title2}
      </h2>
    </div>
    <div class="benefits-grid">
      {benefits.map((benefit, index) => (
        <article class={`team-benefit team-benefit-${index + 1}`}>
          <div class="benefit-symbol">
            <Icon name={benefit.icon} size={72} />
          </div>
          <GlassSurface class="benefit-copy" clear>
            <h3>{benefit.title}</h3>
            <p>{benefit.text}</p>
          </GlassSurface>
        </article>
      ))}
    </div>
  </div>
</section>

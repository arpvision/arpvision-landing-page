---
import { site } from '../config/site';
import { money } from '../lib/business';
const { id } = Astro.props;
---

<p class="footnote" id={id}>
  ¹{' '}
  {site.market.researchDate
    ? `Valores de referência de mercado, pesquisados em ${site.market.researchDate}.`
    : `${money(site.market.cameraPrice)} é um valor de referência para uma câmera 360°, não uma cotação verificada.`}
  {site.market.sourceUrl && (
    <>
      {' '}
      <a
        class="market-source"
        href={site.market.sourceUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Consultar referência.
      </a>
    </>
  )}
</p>

---
import { whatsappLink } from '../lib/business';
import { site } from '../config/site';
import { pageLocale } from '../i18n';
import { anchorId } from '../i18n/routes';
interface Props {
  class?: string;
  message?: string;
  label?: string;
}
const { class: className = '', message, label } = Astro.props;
const { locale, t } = pageLocale(Astro);
const href = whatsappLink(message ?? t.whatsappMessage, `#${anchorId(locale, 'contact')}`);
---

<a
  href={href}
  class={className}
  data-whatsapp
  data-contact-pending={!site.contact.whatsapp ? 'true' : undefined}
  target={site.contact.whatsapp ? '_blank' : undefined}
  rel={site.contact.whatsapp ? 'noopener noreferrer' : undefined}
  aria-label={label}
>
  <slot />
</a>

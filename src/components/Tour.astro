---
import QRCode from 'qrcode';
import { site, available, type PageTour } from '../config/site';
import { appLink } from '../lib/business';
import { appLanguageParam, pageLocale } from '../i18n';
import { fill } from '../i18n/fill';
import { anchorId } from '../i18n/routes';
import Icon from './Icon.astro';
const { locale, t } = pageLocale(Astro);
const text = t.tour;
// O navegador recebe os tours já com o texto do idioma da página.
const tours: PageTour[] = site.tours.map((tour) => ({
  ...tour,
  label: tour.label[locale],
  captureTime: tour.captureTime[locale],
}));
const demo = tours[0];
const qrCodes = await Promise.all(
  tours.map((tour) => QRCode.toDataURL(tour.publicUrl, { width: 112, margin: 1 })),
);
const qr = qrCodes[0] ?? '';
// Texto que o script troca depois da carga (abertura, erro, troca de tour).
const messages = {
  coverAlt: text.coverAlt,
  phone: text.phone,
  photos: text.photos,
  time: text.time,
  failed: text.failed,
  newTab: text.newTab,
  pending: text.pending,
  loading: text.loading,
  frameTitle: text.frameTitle,
  dialogLabel: text.dialogLabel,
  closeDialog: text.closeDialog,
};
const embedQuery = new URLSearchParams(appLanguageParam(locale)).toString();
---

<!-- Sem tour publicado, a seção não aparece; os testes injetam tours e removem o hidden. -->
<section class="section tour-section" id={anchorId(locale, 'realTour')} hidden={!available.tour}>
  <div class="container">
    <div class="section-heading tour-heading">
      <div>
        <span class="eyebrow">{text.eyebrow}</span>
        <h2>
          {text.title1}
          <br />
          {text.title2}
        </h2>
        <p>{text.lead}</p>
      </div>
      <span class="outline-badge">
        <Icon name="phone" size={18} /> {text.badge}
      </span>
    </div>
    <div
      data-tour
      data-tours={JSON.stringify(tours)}
      data-qrs={JSON.stringify(qrCodes)}
      data-messages={JSON.stringify(messages)}
      data-embed-query={embedQuery || undefined}
    >
      {tours.length > 1 && (
        <div class="tabs" role="tablist" aria-label={text.tabsLabel}>
          {tours.map((tour, index) => (
            <button
              role="tab"
              id={`tour-tab-${index}`}
              aria-controls="tour-panel"
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              data-tour-index={index}
            >
              {tour.label}
            </button>
          ))}
        </div>
      )}
      <div
        class="tour-viewer"
        id="tour-panel"
        role={tours.length > 1 ? 'tabpanel' : undefined}
        aria-labelledby={tours.length > 1 ? 'tour-tab-0' : undefined}
      >
        <div class="tour-cover" data-tour-cover>
          <img
            src={demo?.cover ?? '/images/interior-1600.webp'}
            srcset={
              !demo
                ? '/images/interior-640.webp 640w, /images/interior-960.webp 960w, /images/interior-1600.webp 1600w'
                : undefined
            }
            sizes="(max-width: 768px) 100vw, 1100px"
            width="1600"
            height="900"
            loading="lazy"
            alt={demo ? fill(text.coverAlt, { name: demo.name }) : text.illustrativeAlt}
            data-tour-image
          />
          <div class="tour-topline">
            <span>
              <Icon name="home" size={16} />
              <span data-tour-name>{demo?.name ?? text.illustrativeName}</span>
            </span>
            <span>360°</span>
          </div>
          <div class="tour-cover-center">
            <button
              class="tour-play"
              data-tour-open
              aria-label={demo ? text.openLabel : text.pendingLabel}
            >
              <Icon name="play" size={30} />
            </button>
            <strong>{demo ? text.open : text.demo}</strong>
            <span>{demo ? text.openHint : text.pendingHint}</span>
          </div>
          <div class="tour-bottomline">
            <span>
              <Icon name="move" size={18} /> {text.explore}
            </span>
            <span>{demo ? text.captured : text.illustrative}</span>
          </div>
        </div>
        <div class="tour-frame-host" data-tour-host hidden></div>
        <div class="tour-status" data-tour-status role="status" hidden></div>
      </div>
      <div class="tour-details">
        <div>
          <div class="technical-chips">
            <span data-tour-phone>
              {fill(text.phone, { phone: demo?.phone ?? text.toBeDefined })}
            </span>
            <span data-tour-photos>
              {fill(text.photos, { photos: demo?.photosPerRoom ?? text.toBeDefined })}
            </span>
            <span>{text.noTripod}</span>
            <span data-tour-time>
              {fill(text.time, { time: demo?.captureTime ?? text.toBeDefined })}
            </span>
            <span>{text.ready}</span>
          </div>
          <a class="text-link" href={appLink('tour-real', 'register', locale)} data-cta="tour-real">
            {text.cta} <Icon name="arrow" size={18} />
          </a>
        </div>
        {demo && (
          <a href={demo.publicUrl} target="_blank" rel="noopener noreferrer" class="tour-qr">
            <img src={qr} width="80" height="80" alt={text.qrAlt} data-tour-qr />
            <span>
              {text.qrLine1}
              <br />
              <strong>{text.qrLine2}</strong>
            </span>
          </a>
        )}
      </div>
    </div>
  </div>
</section>
<script>
  import '../scripts/tour';
</script>

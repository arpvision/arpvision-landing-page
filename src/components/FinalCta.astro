---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import ContactLink from './ContactLink.astro';
import { appLink } from '../lib/business';
---

<section class="final-cta">
  <div class="container final-cta-inner">
    <div>
      <Brand white />
      <h2>O seu espaço pode ter tour 360° hoje.</h2>
      <p>Você já tem o celular. O próximo passo é seu.</p>
    </div>
    <div class="final-cta-actions">
      <a href={appLink('chamada-final')} class="button button-white" data-cta="chamada-final">
        Criar conta grátis <Icon name="arrow" size={18} />
      </a>
      <ContactLink class="button button-on-blue">
        <Icon name="message" size={19} /> Falar no WhatsApp
      </ContactLink>
      <span>Sem cartão. Sem baixar app.</span>
    </div>
  </div>
</section>

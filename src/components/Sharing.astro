---
import Icon from './Icon.astro';
import ChatPreview from './ChatPreview.astro';
import { pageLocale } from '../i18n';
const { t } = pageLocale(Astro);
const text = t.sharing;
const channels = [
  { icon: 'message', ...text.channels.whatsapp },
  { icon: 'code', ...text.channels.site },
  { icon: 'home', ...text.channels.visit },
];
---

<section
  class="section sharing-section"
  id="compartilhamento"
  aria-labelledby="sharing-title"
  data-atmosphere="sharing"
>
  <div class="container sharing-grid">
    <div class="sharing-copy">
      <span class="eyebrow">
        <span class="sharing-dot"></span> {text.eyebrow}
      </span>
      <h2 id="sharing-title">
        {text.title1}
        <br class="desktop-break" /> {text.title2}
      </h2>
      <div class="sharing-channels">
        {channels.map((channel) => (
          <article>
            <span class="icon-tile">
              <Icon name={channel.icon} size={24} />
            </span>
            <div>
              <h3>{channel.title}</h3>
              <p>{channel.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
    {text.conversationImage ? (
      <figure class="sharing-conversation">
        <img
          src={text.conversationImage.src}
          width="720"
          height="1280"
          loading="lazy"
          decoding="async"
          alt={text.conversationImage.alt}
        />
      </figure>
    ) : (
      <ChatPreview />
    )}
  </div>
</section>

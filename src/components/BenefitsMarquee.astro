---
import { pageLocale } from '../i18n';
const { t } = pageLocale(Astro);
const words = t.showcase.words;
---

<div
  class="benefit-marquee"
  data-benefit-marquee
  style={`--marquee-duration: ${words.length * 4.5}s`}
>
  <div class="marquee-window">
    <div class="marquee-track">
      <ul class="marquee-list" aria-label={t.showcase.marqueeLabel}>
        {words.map((word) => (
          <li>
            <span class="marquee-word">{word}</span>
          </li>
        ))}
      </ul>
      <ul class="marquee-list marquee-clone" aria-hidden="true">
        {words.map((word) => (
          <li>
            <span class="marquee-word">{word}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>
<script>
  import '../scripts/benefits-marquee';
</script>

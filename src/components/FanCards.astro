---
import GlassSurface from './GlassSurface.astro';
import Icon from './Icon.astro';
interface Props {
  items: {
    number: string;
    title: string;
    image: string;
    alt: string;
    position: string;
    labelTone?: 'light' | 'dark';
    arrowTone?: 'light' | 'dark';
  }[];
}
const { items } = Astro.props;
const center = (items.length - 1) / 2;
---

<div class="fan fan-photos" data-fan aria-label="Ambientes fotografados com o celular">
  <ul class="fan-stage" aria-label="Miniaturas de ambientes em 360 graus">
    {items.map((item, index) => (
      <li
        class="fan-position"
        data-fan-center={index === Math.floor(center) ? '' : undefined}
        data-label-tone={item.labelTone}
        data-arrow-tone={item.arrowTone}
        style={`--fan-offset: ${index - center}; --fan-distance: ${Math.abs(index - center)}; --fan-layer: ${items.length - Math.abs(index - center)}`}
      >
        <GlassSurface
          as="article"
          class="use-card fan-card"
          id={`use-${item.number}`}
          tabindex="0"
          label={item.title}
          liquid
        >
          <div class="fan-photo-media">
            <img
              src={item.image}
              alt={item.alt}
              style={`object-position: ${item.position}`}
              width="1600"
              height="800"
              decoding="async"
            />
          </div>
          <GlassSurface
            as="a"
            class="fan-arrow"
            href="#presentation-tour"
            label={`Ver tour de demonstração: ${item.title}`}
            liquid
            clear
          >
            <Icon name="arrow" size={22} />
          </GlassSurface>
          <GlassSurface
            as="a"
            class="fan-room-link"
            href="#presentation-tour"
            label="ambiente x — ver tour de demonstração"
            liquid
            clear
          >
            <span>ambiente x</span>
          </GlassSurface>
        </GlassSurface>
      </li>
    ))}
  </ul>
  <GlassSurface class="fan-controls">
    {items.map((item, index) => (
      <button
        type="button"
        data-fan-select={index}
        aria-controls={`use-${item.number}`}
        aria-label={`Destacar cartão: ${item.title}`}
        aria-pressed={index === Math.floor(center) ? 'true' : 'false'}
      >
        <span class="fan-control-dot" aria-hidden="true"></span>
      </button>
    ))}
  </GlassSurface>
</div>
<script is:inline>
  // Apenas a ponta aparece na abertura; o leque se revela com a rolagem.
  const fan = document.currentScript.previousElementSibling;
  if (fan) {
    fan.dataset.fanState = matchMedia('(prefers-reduced-motion: reduce)').matches
      ? 'open'
      : 'stacked';
  }
</script>
<script>
  import '../scripts/fan';
</script>

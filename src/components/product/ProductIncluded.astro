---
// "O que está incluído" de uma página de produto: de seis a oito itens, cada um com um ícone. Os
// ícones (nomes de Icon.astro) seguem a ordem dos itens.
import Icon from '../Icon.astro';
interface Props {
  title: string;
  items: { title: string; text: string }[];
  icons: string[];
}
const { title, items, icons } = Astro.props;
---

<section class="section product-included-section" aria-labelledby="included-title">
  <div class="container">
    <div class="section-heading center">
      <h2 id="included-title">{title}</h2>
    </div>
    <ul class="product-included" role="list">
      {items.map((item, index) => (
        <li>
          <span class="icon-tile">
            <Icon name={icons[index]} size={22} />
          </span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

---
// A dor que o cliente reconhece, sem depoimento de ninguém. O fim do título troca sozinho entre
// os trechos (scripts/rotating-phrase.ts) e para no primeiro. O leitor de tela ouve a frase
// inteira, com o primeiro trecho, uma vez só: o que se vê fica fora dele. A tela de exemplo do
// produto entra pelo slot, ao lado.
interface Props {
  eyebrow: string;
  before: string;
  phrases: string[];
  after: string;
  text: string;
}
const { eyebrow, before, phrases, after, text } = Astro.props;
---

<section class="section product-pain" aria-labelledby="pain-title">
  <div class="container product-pain-grid">
    <div class="product-pain-copy">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="pain-title" id="pain-title">
        <span class="sr-only">{`${before} ${phrases[0]}`}</span>
        <span aria-hidden="true">
          {`${before} `}
          <span class="rotating-phrase" data-rotating-phrase>
            {phrases.map((phrase, index) => (
              <span class={index === 0 ? 'is-active' : undefined}>{phrase}</span>
            ))}
          </span>
        </span>
      </h2>
      <p class="pain-after">{after}</p>
      <p>{text}</p>
    </div>
    <slot />
  </div>
</section>
<script>
  import '../../scripts/rotating-phrase';
</script>

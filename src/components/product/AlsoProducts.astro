---
// "Conheça também", no fim de uma página de produto: os outros produtos no ar, como no menu
// Produtos (o tour leva à home), nos cartões de ProductCards. Sem nenhum outro produto no ar, a
// seção não aparece.
import ProductCards from './ProductCards.astro';
import { pageLocale } from '../../i18n';
import { liveProductsWithText, type ProductId } from '../../lib/products';
interface Props {
  /** O produto da página, que fica de fora. */
  current: ProductId;
}
const { current } = Astro.props;
const { locale, t } = pageLocale(Astro);
const others = liveProductsWithText(locale).filter(({ product }) => product.id !== current);
---

<ProductCards items={others} title={t.products.also} titleId="also-title" class="also-products" />

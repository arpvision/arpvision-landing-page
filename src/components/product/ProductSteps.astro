---
// "Como funciona" de uma página de produto: os passos, em ordem, com o número, o título e o texto.
interface Props {
  title: string;
  items: { title: string; text: string }[];
}
const { title, items } = Astro.props;
---

<section class="section product-steps-section" aria-labelledby="steps-title">
  <div class="container">
    <div class="section-heading center">
      <h2 id="steps-title">{title}</h2>
    </div>
    <ol class="product-steps">
      {items.map((item, index) => (
        <li>
          <span class="product-step-number" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

---
// "Assim ficam os seus posts": as oito artes do Piloto automático para Instagram. O texto de cada
// arte vem do dicionário (`gallery.arts`, na ordem dele); a foto, o formato e o que ela anuncia
// ficam aqui, pelo `id` da arte, e um id sem par para o build. Antes de cada arte, a descrição só
// para o leitor de tela, que começa por "Exemplo:".
import type { ComponentProps } from 'astro/types';
import PostArt from '../mocks/PostArt.astro';
import { pageLocale } from '../../i18n';
import { pairById } from '../../lib/products';
const { t } = pageLocale(Astro);
const { gallery } = t.productPages.instagram;
const layout: Record<string, Omit<ComponentProps<typeof PostArt>, 'art'>> = {
  sale: { photo: 'patio-piscina-4x5', listing: true },
  rent: { photo: 'sala-2-4x5', listing: true },
  sold: { photo: 'patio-fachada-4x5' },
  tour: { photo: 'quarto-com-suite-4x5', listing: true },
  neighborhood: { tone: 'blue', icon: 'globe' },
  tip: { tone: 'light', icon: 'audit' },
  valuation: { photo: 'cozinha-4x5' },
  story: { photo: 'patio-piscina-9x16', story: true, listing: true, whatsapp: true },
};
const arts = pairById('PostGallery', gallery.arts, layout);
---

<section class="section post-gallery-section" aria-labelledby="gallery-title">
  <div class="container">
    <div class="section-heading center">
      <h2 id="gallery-title">{gallery.title}</h2>
      <p>{gallery.lead}</p>
    </div>
    <ul class="post-gallery" role="list">
      {arts.map(([art, look]) => (
        <li>
          <p class="sr-only">{`${t.products.example}: ${art.kind}. ${art.title}`}</p>
          <PostArt art={art} {...look} />
        </li>
      ))}
    </ul>
  </div>
</section>

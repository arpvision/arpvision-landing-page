---
import Icon from './Icon.astro';
import { pageLocale } from '../i18n';
import type { FeatureValue } from '../lib/content';
interface Props {
  value: FeatureValue;
}
const { value } = Astro.props;
const { t } = pageLocale(Astro);
---

{value === true ? (
  <span class="included">
    <Icon name="check" size={19} />
    <span class="sr-only">{t.features.included}</span>
  </span>
) : value === false ? (
  <span aria-label={t.features.notIncluded}>—</span>
) : value === t.features.comingSoon ? (
  <span class="coming-soon">{t.features.comingSoon}</span>
) : (
  value
)}

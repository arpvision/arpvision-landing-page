---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import GlassSurface from './GlassSurface.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import { appLink } from '../lib/business';
import { site, available } from '../config/site';
import { pageLocale } from '../i18n';
import { anchorId, pagePath } from '../i18n/routes';
const { locale, t } = pageLocale(Astro);
const home = pagePath(locale, 'home');
const isHome = Astro.url.pathname === home;
const anchor = (id: Parameters<typeof anchorId>[1]) =>
  `${isHome ? '' : home}#${anchorId(locale, id)}`;
const tutorialsPath = pagePath(locale, 'tutorials');
const tutorialsCurrent = Astro.url.pathname.startsWith(tutorialsPath)
  ? ('page' as const)
  : undefined;
// Sem preços públicos, o item "Planos" vira "Cotação" e leva à seção da Home.
const plansPath = pagePath(locale, 'plans');
const plans = site.pricing.showPrices
  ? {
      href: plansPath,
      spy: anchorId(locale, 'plans'),
      label: t.header.plans,
      current: Astro.url.pathname.startsWith(plansPath) ? ('page' as const) : undefined,
    }
  : {
      href: anchor('quote'),
      spy: anchorId(locale, 'quote'),
      label: t.header.quote,
      current: undefined,
    };
// Com tour de demonstração, "Tour real" entra no menu e ele só cabe no cabeçalho compacto
// (data-long-nav, em global.css).
---

<header
  class="site-header"
  data-home={isHome ? 'true' : undefined}
  data-long-nav={available.tour ? '' : undefined}
>
  <GlassSurface class="header-capsule" liquid clear>
    <div class="header-inner">
      <Brand />
      <nav class="desktop-nav" aria-label={t.header.mainNav}>
        <a href={anchor('howItWorks')} data-spy={anchorId(locale, 'howItWorks')}>
          {t.header.howItWorks}
        </a>
        {available.tour && (
          <a href={anchor('realTour')} data-spy={anchorId(locale, 'realTour')}>
            {t.header.realTour}
          </a>
        )}
        {t.inPerson && (
          <a href={anchor('inPerson')} data-spy={anchorId(locale, 'inPerson')}>
            {t.inPerson.nav}
          </a>
        )}
        <a href={plans.href} data-spy={plans.spy} aria-current={plans.current}>
          {plans.label}
        </a>
        <a href={anchor('faq')} data-spy={anchorId(locale, 'faq')}>
          {t.header.faq}
        </a>
        <!-- Página própria, não seção da Home: sem data-spy. -->
        <a href={tutorialsPath} aria-current={tutorialsCurrent}>
          {t.header.tutorials}
        </a>
      </nav>
      <div class="header-actions">
        <LanguageSwitch class="desktop-language" />
        <button class="theme-toggle desktop-theme-toggle" data-theme-toggle aria-pressed="false">
          <span class="only-light">
            <Icon name="moon" size={20} />
          </span>
          <span class="only-dark">
            <Icon name="sun" size={20} />
          </span>
          <span class="sr-only">{t.header.darkTheme}</span>
        </button>
        <a class="login-link" href={appLink('cabecalho', 'login', locale)}>
          {t.header.login}
        </a>
        <a
          class="button button-primary button-small"
          href={appLink('cabecalho', 'register', locale)}
          data-cta="cabecalho"
        >
          <span class="desktop-label">{t.header.signup}</span>
          <span class="mobile-label">{t.header.signupShort}</span>
          <Icon name="arrow" size={16} />
        </a>
        <button class="menu-toggle" aria-controls="mobile-nav" aria-expanded="false">
          <span class="menu-icon-open">
            <Icon name="menu" size={22} />
          </span>
          <span class="menu-icon-close">
            <Icon name="close" size={22} />
          </span>
          <span class="menu-label" data-menu-label data-label-close={t.header.close}>
            {t.header.menu}
          </span>
        </button>
      </div>
    </div>
    <nav id="mobile-nav" class="mobile-nav" aria-label={t.header.mobileNav} hidden>
      <a href={anchor('howItWorks')}>{t.header.howItWorks}</a>
      {available.tour && <a href={anchor('realTour')}>{t.header.realTour}</a>}
      {t.inPerson && <a href={anchor('inPerson')}>{t.inPerson.nav}</a>}
      <a href={plans.href} aria-current={plans.current}>
        {plans.label}
      </a>
      <a href={anchor('faq')}>{t.header.faq}</a>
      <a href={tutorialsPath} aria-current={tutorialsCurrent}>
        {t.header.tutorials}
      </a>
      <a href={appLink('cabecalho', 'login', locale)}>
        {t.header.loginLong} <Icon name="arrow" size={18} />
      </a>
      <button class="mobile-theme-toggle" data-theme-toggle aria-pressed="false">
        <span>{t.header.darkTheme}</span>
        <span class="switch" aria-hidden="true"></span>
      </button>
      <div class="mobile-language">
        <span aria-hidden="true">{t.language.label}</span>
        <LanguageSwitch />
      </div>
      <a
        class="button button-primary mobile-nav-cta"
        href={appLink('menu', 'register', locale)}
        data-cta="menu"
      >
        {t.header.signup} <Icon name="arrow" size={18} />
      </a>
    </nav>
  </GlassSurface>
</header>
<script is:inline>
  const header = document.currentScript.previousElementSibling;
  if (header) {
    header.dataset.headerEnhanced = '';
    if (header.dataset.home === 'true') header.dataset.headerSurface = 'opening';
  }
</script>

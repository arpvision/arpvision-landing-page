---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { appLink } from '../lib/business';
import { available } from '../config/site';
const isHome = Astro.url.pathname === '/';
const anchor = (id: string) => `${isHome ? '' : '/'}#${id}`;
---

<header class="site-header">
  <div class="container header-inner">
    <Brand />
    <nav class="desktop-nav" aria-label="Navegação principal">
      <a href={anchor('como-funciona')} data-spy="como-funciona">
        Como funciona
      </a>
      {available.tour && (
        <a href={anchor('tour-real')} data-spy="tour-real">
          Tour real
        </a>
      )}
      <a
        href="/planos"
        data-spy="planos"
        aria-current={Astro.url.pathname.startsWith('/planos') ? 'page' : undefined}
      >
        Planos
      </a>
      <a href={anchor('duvidas')} data-spy="duvidas">
        Dúvidas
      </a>
    </nav>
    <div class="header-actions">
      <button class="theme-toggle desktop-theme-toggle" data-theme-toggle aria-pressed="false">
        <span class="only-light">
          <Icon name="moon" size={20} />
        </span>
        <span class="only-dark">
          <Icon name="sun" size={20} />
        </span>
        <span class="sr-only">Tema escuro</span>
      </button>
      <a class="login-link" href={appLink('cabecalho', 'login')}>
        Entrar
      </a>
      <a
        class="button button-primary button-small"
        href={appLink('cabecalho')}
        data-cta="cabecalho"
      >
        <span class="desktop-label">Criar conta grátis</span>
        <span class="mobile-label">Criar conta</span>
        <Icon name="arrow" size={16} />
      </a>
      <button class="menu-toggle" aria-controls="mobile-nav" aria-expanded="false">
        <span class="menu-icon-open">
          <Icon name="menu" size={22} />
        </span>
        <span class="menu-icon-close">
          <Icon name="close" size={22} />
        </span>
        <span class="menu-label" data-menu-label>
          Menu
        </span>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Navegação no celular" hidden>
    <a href={anchor('como-funciona')}>Como funciona</a>
    {available.tour && <a href={anchor('tour-real')}>Tour real</a>}
    <a href="/planos" aria-current={Astro.url.pathname.startsWith('/planos') ? 'page' : undefined}>
      Planos
    </a>
    <a href={anchor('duvidas')}>Dúvidas</a>
    <a href={appLink('cabecalho', 'login')}>
      Entrar na minha conta <Icon name="arrow" size={18} />
    </a>
    <button class="mobile-theme-toggle" data-theme-toggle aria-pressed="false">
      <span>Tema escuro</span>
      <span class="switch" aria-hidden="true"></span>
    </button>
    <a class="button button-primary mobile-nav-cta" href={appLink('menu')} data-cta="menu">
      Criar conta grátis <Icon name="arrow" size={18} />
    </a>
  </nav>
</header>

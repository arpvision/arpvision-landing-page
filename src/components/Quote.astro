---
import Icon from './Icon.astro';
import ContactLink from './ContactLink.astro';
import { site } from '../config/site';
import { appLink } from '../lib/business';
import { pageLocale } from '../i18n';
import { anchorId } from '../i18n/routes';

// Cotação pelo WhatsApp enquanto os preços não são públicos (site.pricing.showPrices).
// Três toques montam uma mensagem pronta, no idioma da página; a pessoa vê o texto e só
// precisa enviar. Sem JS, o botão abre o WhatsApp com a mensagem padrão.
const { locale, t } = pageLocale(Astro);
const text = t.quote;
const questions = (['perfil', 'volume', 'prazo'] as const).map((id) => ({
  id,
  ...text.questions[id],
}));
const greeting = text.greeting;
const benefits = [
  { icon: 'target', ...text.benefits.volume },
  { icon: 'phone', ...text.benefits.phone },
  { icon: 'message', ...text.benefits.team },
];
---

<section class="section quote-section" id={anchorId(locale, 'quote')} aria-labelledby="quote-title">
  <div class="container quote-layout">
    <div class="quote-copy">
      <span class="eyebrow">
        <span class="eyebrow-line"></span> {text.eyebrow}
      </span>
      <h2 id="quote-title">{text.title}</h2>
      <p class="quote-lead">{text.lead}</p>
      <ul class="quote-benefits">
        {benefits.map((benefit) => (
          <li>
            <span class="icon-tile">
              <Icon name={benefit.icon} size={20} />
            </span>
            <span>
              <strong>{benefit.title}</strong> {benefit.text}
            </span>
          </li>
        ))}
      </ul>
    </div>
    <div class="quote-card" data-quote data-greeting={greeting} data-closing={text.closing}>
      {questions.map((question, index) => (
        <fieldset class="quote-question" data-summary={question.summary}>
          <legend>
            <span class="quote-step" aria-hidden="true">
              {index + 1}
            </span>
            {question.label}
          </legend>
          <div class="quote-options">
            {question.options.map((option) => (
              <label class="quote-option">
                <input type="radio" name={`cotacao-${question.id}`} value={option} />
                <span>{option}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))}
      <div class="quote-preview">
        <span class="quote-preview-label">{text.preview}</span>
        <p class="quote-bubble" data-quote-preview>
          {greeting}
        </p>
      </div>
      <div class="quote-actions">
        <ContactLink class="button button-primary quote-submit" message={greeting}>
          <Icon name="message" size={19} /> {text.submit}
        </ContactLink>
        <p class="quote-note">{text.note}</p>
      </div>
    </div>
  </div>
  <p class="container quote-trial">
    {text.trial(site.pricing.freeTrialCredits, site.pricing.freeTrialDays)}{' '}
    <a href={appLink('cotacao-teste', 'register', locale)} data-cta="cotacao-teste">
      {text.signup}
    </a>
  </p>
</section>
<script>
  import '../scripts/quote';
</script>

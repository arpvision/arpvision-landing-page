---
import Icon from './Icon.astro';
// Explica a cobrança por ambiente antes dos planos.
const flow = [
  { icon: 'phone', value: '30 segundos', text: 'Uma volta só com o celular, em cada ambiente.' },
  {
    icon: 'sparkle',
    value: '1 imagem 360°',
    text: 'As fotos viram uma imagem única, em alta qualidade.',
  },
  { icon: 'credits', value: '1 crédito', text: 'É o que cada ambiente usa do saldo do plano.' },
];
---

<section class="section credits-section" id="creditos" data-atmosphere="credits">
  <div class="container">
    <div class="section-heading center">
      <h2>
        Cada ambiente vira uma
        <br class="desktop-break" /> imagem 360° de alta qualidade.
      </h2>
      <p>Você não paga por foto nem por tour. Paga por ambiente pronto.</p>
    </div>
    <ol class="credit-flow">
      {flow.map((step) => (
        <li>
          <span class="icon-tile">
            <Icon name={step.icon} size={24} />
          </span>
          <strong>{step.value}</strong>
          <span>{step.text}</span>
        </li>
      ))}
    </ol>
    <p class="credit-example">
      Na prática: uma casa com sala, cozinha, 2 quartos, 1 banheiro tem 5 ambientes, ou seja, 5
      créditos.
    </p>
  </div>
</section>

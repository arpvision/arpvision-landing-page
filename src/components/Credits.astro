---
import Icon from './Icon.astro';
import { pageLocale } from '../i18n';
const { t } = pageLocale(Astro);
// Explica a cobrança por ambiente antes dos planos.
const flow = [
  { icon: 'phone', ...t.credits.flow.capture },
  { icon: 'sparkle', ...t.credits.flow.image },
  { icon: 'credits', ...t.credits.flow.credit },
];
---

<section class="section credits-section" id="creditos" data-atmosphere="credits">
  <div class="container">
    <div class="section-heading center">
      <h2>
        {t.credits.title1}
        <br class="desktop-break" /> {t.credits.title2}
      </h2>
      <p>{t.credits.lead}</p>
    </div>
    <ol class="credit-flow">
      {flow.map((step) => (
        <li>
          <span class="icon-tile">
            <Icon name={step.icon} size={24} />
          </span>
          <strong>{step.value}</strong>
          <span>{step.text}</span>
        </li>
      ))}
    </ol>
    <p class="credit-example">{t.credits.example}</p>
  </div>
</section>

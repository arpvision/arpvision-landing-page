---
import Brand from './Brand.astro';
import ContactLink from './ContactLink.astro';
import Icon from './Icon.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import { site, available } from '../config/site';
import { appLink } from '../lib/business';
import { liveProductsWithText, productHref, type ProductId } from '../lib/products';
import { pageLocale } from '../i18n';
import { anchorId, pagePath, publishedPageIds, sectionPath } from '../i18n/routes';
// A mensagem e o produto da página: o link de WhatsApp do rodapé e o botão flutuante falam dele.
interface Props {
  whatsappMessage?: string;
  product?: ProductId;
}
const { whatsappMessage, product } = Astro.props;
const { locale, t } = pageLocale(Astro);
const { freeTrialCredits, freeTrialDays } = site.pricing;
// A coluna Produtos mostra o que está no ar, como o menu, e o "Ver todos" quando /produtos existe.
const path = Astro.url.pathname;
const productLinks = liveProductsWithText(locale).map((item) => ({
  href: productHref(locale, item.product, path),
  name: item.text.name,
}));
const allProducts = publishedPageIds.includes('products') ? pagePath(locale, 'products') : null;
---

<footer class="site-footer" id={anchorId(locale, 'contact')}>
  <div class="container footer-grid">
    <div class="footer-brand">
      <Brand />
      <p>
        {t.footer.taglineLines[0]}
        <br />
        {t.footer.taglineLines[1]}
      </p>
      <p>{t.footer.headquarters}</p>
    </div>
    <div class="footer-products">
      <h2>{t.footer.products}</h2>
      {productLinks.map((link) => (
        <a href={link.href}>{link.name}</a>
      ))}
      {allProducts && <a href={allProducts}>{t.header.viewAllProducts}</a>}
    </div>
    <div>
      <h2>{t.footer.discover}</h2>
      <a href={sectionPath(locale, 'home', 'howItWorks')}>{t.footer.howItWorks}</a>
      {available.tour && <a href={sectionPath(locale, 'home', 'realTour')}>{t.footer.realTour}</a>}
      {site.pricing.showPrices ? (
        <a href={pagePath(locale, 'plans')}>{t.footer.plans}</a>
      ) : (
        <a href={sectionPath(locale, 'home', 'quote')}>{t.footer.quote}</a>
      )}
      <a href={sectionPath(locale, 'home', 'faq')}>{t.footer.faq}</a>
      <a href={pagePath(locale, 'tutorials')}>{t.footer.tutorials}</a>
    </div>
    <div>
      <h2>{t.footer.start}</h2>
      <a href={appLink('rodape', 'register', locale)} data-cta="rodape">
        {t.footer.signup}
      </a>
      <a href={appLink('rodape', 'login', locale)}>{t.footer.login}</a>
    </div>
    {(available.email || available.whatsapp) && (
      <div class="footer-contact">
        <h2>{t.footer.talk}</h2>
        {available.email && <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>}
        {available.whatsapp && (
          <ContactLink message={whatsappMessage} product={product}>
            {t.footer.whatsapp(site.contact.whatsapp)}
          </ContactLink>
        )}
        <span class="footer-note">{t.footer.note}</span>
      </div>
    )}
  </div>
  <div class="container footer-bottom">
    <p>
      © {site.company.year} ARP Vision{site.company.legalName ? ` · ${site.company.legalName}` : ''}
      {site.company.cnpj ? ` · ${t.footer.cnpj} ${site.company.cnpj}` : ''}
    </p>
    <LanguageSwitch landmark />
    <div>
      <a href={pagePath(locale, 'terms')}>{t.footer.terms}</a>
      <a href={pagePath(locale, 'privacy')}>{t.footer.privacy}</a>
    </div>
  </div>
</footer>
{available.whatsapp && (
  <aside aria-label={t.footer.quickContact}>
    <ContactLink
      class="floating-whatsapp"
      label={t.footer.floatingWhatsapp}
      message={whatsappMessage}
      product={product}
    >
      <Icon name="message" size={25} />
    </ContactLink>
  </aside>
)}
<dialog id="contact-dialog" class="contact-dialog" aria-labelledby="contact-title">
  <button class="dialog-close icon-button" data-close-dialog aria-label={t.contactDialog.close}>
    <Icon name="close" />
  </button>
  <span class="icon-tile">
    <Icon name="message" />
  </span>
  <h2 id="contact-title">{t.contactDialog.title}</h2>
  <p>{t.contactDialog.text(freeTrialCredits, freeTrialDays)}</p>
  <a class="button button-primary" href={appLink('contato', 'register', locale)} data-cta="contato">
    {t.contactDialog.signup} <Icon name="arrow" size={18} />
  </a>
</dialog>

---
import { site, available } from '../config/site';
import { appLink } from '../lib/business';
import Icon from './Icon.astro';
const phonePattern = String.raw`[+0-9\(\)\s\-]{10,20}`;
---

<section class="section founders-section" id="fundadores">
  <div class="container founders-grid">
    <div>
      <span class="eyebrow">PROGRAMA FUNDADORES</span>
      <h2>
        O começo de uma
        <br />
        nova forma de
        <br />
        <span>mostrar espaços.</span>
      </h2>
      <h3>
        {site.founders.spots
          ? `Seja uma das ${site.founders.spots} empresas fundadoras.`
          : 'Seja uma das empresas fundadoras.'}
      </h3>
      <p>
        {site.founders.discount &&
          `${site.founders.discount} de desconto nas condições do Programa Fundadores. `}
        Um canal direto com quem constrói o produto. Em troca, queremos ouvir você e, se gostar,
        contar a sua história aqui.
      </p>
      <div class="founder-benefit">
        <Icon name="message" size={21} />
        <span>Sua experiência ajuda a construir os próximos passos.</span>
      </div>
      {site.founders.remainingSpots !== null && (
        <p class="remaining-spots">{site.founders.remainingSpots} vagas disponíveis</p>
      )}
    </div>
    {available.foundersChannel ? (
      <form
        class="founders-form"
        data-founders-form
        data-endpoint={site.founders.formEndpoint}
        data-phone={site.contact.whatsapp}
        novalidate
      >
        <h3>Vamos construir isso juntos?</h3>
        <p>Conte um pouco sobre a sua empresa.</p>
        <label for="founder-name">Seu nome</label>
        <input
          id="founder-name"
          name="name"
          autocomplete="name"
          placeholder="Como podemos chamar você?"
          maxlength="100"
          aria-describedby="founder-name-error"
          required
        />
        <p class="field-error" id="founder-name-error" hidden></p>
        <label for="founder-company">Empresa</label>
        <input
          id="founder-company"
          name="company"
          autocomplete="organization"
          placeholder="Nome da empresa ou do seu negócio"
          maxlength="140"
          aria-describedby="founder-company-error"
          required
        />
        <p class="field-error" id="founder-company-error" hidden></p>
        <div class="form-row">
          <div>
            <label for="founder-city">Cidade / UF</label>
            <input
              id="founder-city"
              name="city"
              autocomplete="address-level2"
              placeholder="Ex.: São Paulo / SP"
              maxlength="100"
              aria-describedby="founder-city-error"
              required
            />
            <p class="field-error" id="founder-city-error" hidden></p>
          </div>
          <div>
            <label for="founder-agents">Tamanho da equipe</label>
            <input
              id="founder-agents"
              name="agents"
              type="number"
              inputmode="numeric"
              min="1"
              max="10000"
              placeholder="Ex.: 5"
              aria-describedby="founder-agents-error"
              required
            />
            <p class="field-error" id="founder-agents-error" hidden></p>
          </div>
        </div>
        <label for="founder-phone">WhatsApp com DDD</label>
        <input
          id="founder-phone"
          name="phone"
          type="tel"
          inputmode="tel"
          autocomplete="tel"
          placeholder="(11) 99999-9999"
          pattern={phonePattern}
          maxlength="20"
          aria-describedby="founder-phone-error"
          required
        />
        <p class="field-error" id="founder-phone-error" hidden></p>
        <label class="consent">
          <input type="checkbox" name="consent" aria-describedby="founder-consent-error" required />
          <span>
            Concordo em receber contato sobre o Programa Fundadores e li a{' '}
            <a href="/politica-de-privacidade">Política de Privacidade</a>.
          </span>
        </label>
        <p class="field-error" id="founder-consent-error" hidden></p>
        <button type="submit" class="button button-primary">
          Quero ser uma empresa fundadora <Icon name="arrow" size={18} />
        </button>
        <p class="form-status" role="status" aria-live="polite" data-form-status>
          Sem compromisso. Vamos conversar primeiro.
        </p>
      </form>
    ) : (
      <div class="founders-form founders-soon" data-founders-soon>
        <h3>Inscrições abrem em breve.</h3>
        <p>
          Enquanto isso, crie sua conta grátis e teste a captura com 1 crédito. Sem cartão e sem
          baixar app.
        </p>
        <a class="button button-primary" href={appLink('fundadores')} data-cta="fundadores">
          Criar conta grátis <Icon name="arrow" size={18} />
        </a>
      </div>
    )}
  </div>
</section>
<script>
  import '../scripts/founders';
</script>

---
import Icon from './Icon.astro';
import ProtectedTour from './ProtectedTour.astro';
interface Props {
  src: string;
  items: { icon: string; number: string; title: string; text: string; tag: string }[];
}
const { src, items } = Astro.props;
---

<div class="feature-scroll" data-feature-scroll>
  <div class="container feature-pin">
    <ProtectedTour src={src} />
    <div class="feature-stack" aria-label="O que você faz com a ARP Vision">
      <ol class="feature-stack-list">
        {items.map((item, index) => (
          <li
            class={`feature-position feature-position-${index + 1}`}
            style={`--feature-index: ${index}`}
          >
            <article
              class="feature-card"
              tabindex="0"
              aria-labelledby={`feature-title-${item.number}`}
            >
              <div class="feature-card-top">
                <span>{item.number}+</span>
                <span class="feature-icon">
                  <Icon name={item.icon} size={27} />
                </span>
              </div>
              <div class="feature-card-copy">
                <h3 id={`feature-title-${item.number}`}>{item.title}</h3>
                <p>{item.text}</p>
                <div class="use-tag">
                  <span></span>
                  {item.tag}
                </div>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </div>
</div>
<script>
  import '../scripts/feature-stack';
</script>

---
import { site } from '../config/site';
import { pageLocale } from '../i18n';
import { pagePath } from '../i18n/routes';
const { white = false } = Astro.props;
const { locale, t } = pageLocale(Astro);
const source = white ? site.brand.logoWhite : site.brand.logoBlue;
---

<a
  href={pagePath(locale, 'home')}
  class:list={['brand', { 'brand-white': white }]}
  aria-label={t.brand.home}
>
  {source ? (
    white ? (
      <img src={source} alt="ARP Vision" width="162" height="36" />
    ) : (
      <>
        {/* Logo azul no tema claro e branco no escuro; o CSS mostra só um. */}
        <img class="brand-logo-light" src={source} alt="ARP Vision" width="162" height="36" />
        <img
          class="brand-logo-dark"
          src={site.brand.logoWhite}
          alt="ARP Vision"
          width="162"
          height="36"
        />
      </>
    )
  ) : (
    <span class="brand-wordmark">
      arp<span>vision</span>
      <span class="brand-orbit" aria-hidden="true">
        °
      </span>
    </span>
  )}
</a>

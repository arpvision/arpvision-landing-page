---
import Icon from './Icon.astro';
import { faqGroups } from '../config/site';
// O mesmo FAQ na Home e em /planos: uma lista só, separada por assunto.
---

<section class="section faq-section" id="duvidas" aria-labelledby="faq-title">
  <div class="container faq-layout">
    <div>
      <span class="eyebrow">DÚVIDAS FREQUENTES</span>
      <h2 id="faq-title">Você pergunta.<br />A gente explica.</h2>
      <p>
        Sem letras miúdas.
        <br />
        Entenda cada parte do seu tour.
      </p>
    </div>
    <div class="faq-groups">
      {faqGroups.map((group) => (
        <div class="faq-group">
          <h3>{group.title}</h3>
          <div class="faq-list">
            {group.items.map((item) => (
              <details class="faq-item">
                <summary>
                  {item.question}
                  <Icon name="plus" size={20} />
                </summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

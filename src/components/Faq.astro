---
import Icon from './Icon.astro';
import { pageLocale } from '../i18n';
import { anchorId } from '../i18n/routes';
import { faqGroups } from '../lib/content';
// O mesmo FAQ na Home e em /planos: uma lista só, separada por assunto. A página de um produto
// passa os grupos e o cabeçalho dela; com um grupo só, ele vai sem título (sem um h3 vazio).
interface Props {
  groups?: { title?: string; items: { question: string; answer: string }[] }[];
  eyebrow?: string;
  title1?: string;
  title2?: string;
  lead1?: string;
  lead2?: string;
}
const { locale, t } = pageLocale(Astro);
const {
  groups = faqGroups(locale),
  eyebrow = t.faq.eyebrow,
  title1 = t.faq.title1,
  title2 = t.faq.title2,
  lead1 = t.faq.lead1,
  lead2 = t.faq.lead2,
} = Astro.props;
---

<section class="section faq-section" id={anchorId(locale, 'faq')} aria-labelledby="faq-title">
  <div class="container faq-layout">
    <div>
      <span class="eyebrow">{eyebrow}</span>
      <h2 id="faq-title">{title1}<br />{title2}</h2>
      <p>
        {lead1}
        <br />
        {lead2}
      </p>
    </div>
    <div class="faq-groups">
      {groups.map((group) => (
        <div class="faq-group">
          {group.title && <h3>{group.title}</h3>}
          <div class="faq-list">
            {group.items.map((item) => (
              <details class="faq-item">
                <summary>
                  {item.question}
                  <Icon name="plus" size={20} />
                </summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

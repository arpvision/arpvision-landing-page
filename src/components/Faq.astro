---
import Icon from './Icon.astro';
import { pageLocale } from '../i18n';
import { anchorId } from '../i18n/routes';
import { faqGroups } from '../lib/content';
// O mesmo FAQ na Home e em /planos: uma lista só, separada por assunto.
const { locale, t } = pageLocale(Astro);
const groups = faqGroups(locale);
---

<section class="section faq-section" id={anchorId(locale, 'faq')} aria-labelledby="faq-title">
  <div class="container faq-layout">
    <div>
      <span class="eyebrow">{t.faq.eyebrow}</span>
      <h2 id="faq-title">{t.faq.title1}<br />{t.faq.title2}</h2>
      <p>
        {t.faq.lead1}
        <br />
        {t.faq.lead2}
      </p>
    </div>
    <div class="faq-groups">
      {groups.map((group) => (
        <div class="faq-group">
          <h3>{group.title}</h3>
          <div class="faq-list">
            {group.items.map((item) => (
              <details class="faq-item">
                <summary>
                  {item.question}
                  <Icon name="plus" size={20} />
                </summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

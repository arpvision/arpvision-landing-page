---
import interFontUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  schema?: Record<string, unknown>[];
}
const {
  title,
  description = 'Faça o tour virtual 360° do seu espaço só com o celular. A IA corrige emendas e luz, e o cliente abre o tour pelo WhatsApp, sem criar conta.',
  ogImage = site.media.ogHome,
  schema = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.domain).href;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.domain,
  ...(site.brand.logoBlue ? { logo: new URL(site.brand.logoBlue, site.domain).href } : {}),
  ...(site.contact.email ? { email: site.contact.email } : {}),
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={site.themeColor} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!site.readyToIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={site.brand.symbol} />
    <link rel="preload" href={interFontUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.domain).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, site.domain).href} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify([organization, ...schema]).replace(/</g, '\\u003c')}
    ></script>
    {site.analytics.scriptUrl && site.analytics.domain && (
      <script
        is:inline
        defer
        data-domain={site.analytics.domain}
        src={site.analytics.scriptUrl}
      ></script>
    )}
    <slot name="head" />
  </head>
  <body>
    <a href="#conteudo" class="skip-link">
      Pular para o conteúdo
    </a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

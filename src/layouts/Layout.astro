---
import interFontUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import '../styles/opening.css';
import '../styles/tour-showcase.css';
import '../styles/atmosphere.css';
import '../styles/landing-polish.css';
import '../styles/quote.css';
import '../styles/language.css';
import Header from '../components/Header.astro';
import GlassFilter from '../components/GlassFilter.astro';
import Footer from '../components/Footer.astro';
import LanguageSuggestion from '../components/LanguageSuggestion.astro';
import { site } from '../config/site';
import { defaultLocale, localeInfo, locales, pageLocale } from '../i18n';
import { anchorId, pagePath, type PageId } from '../i18n/routes';
import { organizationSchema, websiteSchema } from '../lib/schema';
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  schema?: Record<string, unknown>[];
  /**
   * Página com versão em cada idioma (canonical, hreflang e a faixa de sugestão de idioma). Sem
   * ela, a página fica fora do índice.
   */
  page?: PageId;
  /** Sem cabeçalho, rodapé e faixa de sugestão de idioma (a página 404, que fala todos). */
  bare?: boolean;
}
const { locale, t } = pageLocale(Astro);
const {
  title,
  description = t.meta.defaultDescription,
  ogImage = t.home.ogImage,
  schema = [],
  page,
  bare = false,
} = Astro.props;
const urlOf = (path: string) => new URL(path, site.domain).href;
const canonical = page ? urlOf(pagePath(locale, page)) : undefined;
// Cada página aponta a versão de todos os idiomas, e o português responde por x-default.
const alternates = page
  ? [
      ...locales.map((code) => ({
        hreflang: localeInfo[code].lang,
        href: urlOf(pagePath(code, page)),
      })),
      { hreflang: 'x-default', href: urlOf(pagePath(defaultLocale, page)) },
    ]
  : [];
const ogImageUrl = new URL(ogImage, site.domain).href;
const ogImageAlt = `${site.name} — ${title}`;
const indexable = site.readyToIndex && page;
const contentId = anchorId(locale, 'content');
---

<!doctype html>
<html lang={localeInfo[locale].lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={site.themeColor} />
    <!-- Aplica o tema escolhido antes de pintar a página (evita piscar claro→escuro). -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    <meta
      name="robots"
      content={
        indexable
          ? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
          : 'noindex, nofollow'
      }
    />
    <link rel="icon" type="image/svg+xml" href={site.brand.symbol} />
    <link rel="preload" href={interFontUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeInfo[locale].ogLocale} />
    {locales
      .filter((code) => code !== locale)
      .map((code) => (
        <meta property="og:locale:alternate" content={localeInfo[code].ogLocale} />
      ))}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify([organizationSchema, websiteSchema(locale), ...schema]).replace(
        /</g,
        '\\u003c',
      )}
    ></script>
    {site.analytics.scriptUrl && site.analytics.domain && (
      <script
        is:inline
        defer
        data-domain={site.analytics.domain}
        src={site.analytics.scriptUrl}
      ></script>
    )}
    <slot name="head" />
  </head>
  <body>
    <GlassFilter />
    <a href={`#${contentId}`} class="skip-link">
      {t.layout.skipLink}
    </a>
    {!bare && <Header />}
    <main id={contentId}>
      <slot />
    </main>
    {!bare && <Footer />}
    {!bare && page && <LanguageSuggestion />}
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
